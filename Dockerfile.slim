# Dory1.0-4B serving image = the Nemotron Deciffusion slim serving image (rc7-candidate, nemotron-deciffusion security-rc7
# 65d3c25: vLLM nightly fe4df3df + the slim-engine overlay + kernels + Rust frontend + security fixes) + the Dory model
# code of vLLM PR #60149 (head 55076950b6c1) as a pure-Python overlay (overlay/install.sh: model/config files, registry
# lines, per-request loops + spec_k). One image serves both models:
#   Deciffusion:  docker run ... <image>                      (entrypoint.sh -> /app/start.sh, as the slim image)
#   Dory:         docker run ... <image> vllm serve /model ... (serve.sh)
# The two overlays touch disjoint hunks (Dory adds lines guarded by model_type == "dory" / request fields "loops",
# "spec_k"; the Deciffusion overlay's files and hunks are untouched), so the Deciffusion path is bit-identical.
# Prebuilt: ghcr.io/pst2154/dory-vllm:slim-rc7-loops-speck-kern-arm64 (linux/arm64, DGX Spark / GB10).
ARG BASE=nemotron-deciffusion:slim-rc7-65d3c25
FROM ${BASE}
USER root
COPY overlay /opt/dory-overlay
COPY --chmod=0755 entrypoint.sh /usr/local/bin/deciffusion-dory-entrypoint
RUN bash /opt/dory-overlay/install.sh \
 && python3 -c "from vllm.transformers_utils.configs import DoryConfig; from vllm.model_executor.models.registry import ModelRegistry; a = ModelRegistry.get_supported_archs(); assert \"DoryForCausalLM\" in a and \"NemotronLabsDiffusionForCausalLM\" in a; import vllm.deciffusion_slim.engine"
USER 10001:0
ENTRYPOINT ["/usr/local/bin/deciffusion-dory-entrypoint"]
CMD []
